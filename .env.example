# Sahip: Damla. Kopyala: cp .env.example .env

# --- Mock bayrağı (YOL_HARITASI.md §6) ---
# true  : günlük geliştirme, herkes sahte servislere karşı çalışır
# false : Cuma entegrasyon seansı, gerçekler konuşur
USE_MOCK=true
VITE_USE_MOCK=true

# --- Postgres ---
POSTGRES_USER=parking
POSTGRES_PASSWORD=parking
POSTGRES_DB=parking
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://parking:parking@localhost:5432/parking

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Servis adresleri ---
CORE_URL=http://localhost:8001
CORE_MOCK_URL=http://localhost:8101
GATEWAY_PORT=8000
CORE_PORT=8001

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_MOCK_API_URL=http://localhost:8100
VITE_WS_URL=ws://localhost:8000/ws/occupancy
VITE_MOCK_WS_URL=ws://localhost:8100/ws/occupancy
